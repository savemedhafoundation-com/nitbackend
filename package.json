    "test:integration": "vitest run tests/auth.integration.test.mjs tests/ebooks.integration.test.mjs",
    "check:migrations": "node scripts/check-ebook-migration.js",
    "migrate:ebooks": "node scripts/migrateEbooks.js",
    "cleanup:ebooks": "node scripts/cleanupEbooks.js",
    "admin:grant": "node scripts/grantAdmin.js",
    "build": "esbuild api/index.js --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=dist/index.cjs",
    "vercel-start": "node src/server.js"
  },
  "keywords": [],
