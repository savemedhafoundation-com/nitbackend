    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
